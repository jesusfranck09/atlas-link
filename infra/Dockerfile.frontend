FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/nxt-ui-atlas-link/package.json frontend/nxt-ui-atlas-link/package-lock.json ./
RUN --mount=type=cache,id=atlas-link-npm,target=/root/.npm npm ci --prefer-offline --no-audit --no-fund
COPY frontend/nxt-ui-atlas-link ./
ARG API_URL=http://gateway:8095
ENV API_URL=$API_URL
ARG NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4430
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=4300
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
USER node
EXPOSE 4300
CMD ["node", "server.js"]
