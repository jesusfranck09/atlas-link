FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY backend ./backend
ARG SERVICE
RUN mvn -q -f backend/pom.xml -pl ${SERVICE} -am package -DskipTests
RUN cp backend/${SERVICE}/target/${SERVICE}-0.1.0.jar /service.jar

FROM eclipse-temurin:21-jre-jammy AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home atlas
WORKDIR /app
COPY --from=build --chown=atlas:atlas /service.jar /app/service.jar
USER atlas
ENV SERVER_ADDRESS=0.0.0.0
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-jar", "/app/service.jar"]
